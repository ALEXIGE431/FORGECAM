<Window x:Class="forgecam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ForgeCAM | Manufacture" Height="900" Width="1500"
        MinHeight="700" MinWidth="1100"
        Background="#171A1F" Foreground="#E7EAF0"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#20242B"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#343A44"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A0A8B5"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#48B7A5"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E7EAF0"/>
            <Setter Property="Background" Value="#2A3039"/>
            <Setter Property="BorderBrush" Value="#414956"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E7EAF0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="104"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="#111317">
            <TextBlock Text="FORGECAM" FontWeight="Bold" Foreground="#48B7A5" Margin="16,0,20,0"/>
            <TextBlock Text="File   Edit   View   Manufacture   Help" Foreground="#C5CBD4"/>
            <TextBlock Text="Prototype · Percorsi utensile non calcolati" Foreground="#E9B96E"
                       HorizontalAlignment="Right" Margin="0,0,16,0"/>
        </DockPanel>

        <Grid Grid.Row="1" Background="#20242B">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#191C22">
                <Button Content="Progetto" Tag="Progetto" Click="Workspace_Click"/>
                <Button Content="Fresatura 3 assi" Tag="Fresatura 3 assi" Click="Workspace_Click"/>
                <Button Content="Tornitura" Tag="Tornitura" Click="Workspace_Click"/>
                <Button Content="Simulazione" Tag="Simulazione" Click="Workspace_Click"/>
                <Button Content="Postprocessore" Tag="Postprocessore" Click="Workspace_Click"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,4">
                <StackPanel Margin="4,0,16,0">
                    <TextBlock Text="SETUP" Foreground="#48B7A5" FontSize="11" FontWeight="Bold"/>
                    <Button Content="Nuovo setup" Tag="Setup" Click="AddOperation_Click"/>
                </StackPanel>
                <StackPanel Margin="4,0,16,0">
                    <TextBlock Text="2D" Foreground="#48B7A5" FontSize="11" FontWeight="Bold"/>
                    <WrapPanel>
                        <Button Content="Spianatura" Tag="Spianatura" Click="AddOperation_Click"/>
                        <Button Content="Contorno" Tag="Contorno 2D" Click="AddOperation_Click"/>
                        <Button Content="Tasca" Tag="Tasca 2D" Click="AddOperation_Click"/>
                        <Button Content="Foratura" Tag="Foratura" Click="AddOperation_Click"/>
                        <Button Content="Smusso" Tag="Smusso" Click="AddOperation_Click"/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Margin="4,0,16,0">
                    <TextBlock Text="3D" Foreground="#48B7A5" FontSize="11" FontWeight="Bold"/>
                    <WrapPanel>
                        <Button Content="Sgrossatura adattiva" Tag="Sgrossatura adattiva 3D" Click="AddOperation_Click"/>
                        <Button Content="Parallelo" Tag="Parallelo" Click="AddOperation_Click"/>
                        <Button Content="Scallop" Tag="Scallop" Click="AddOperation_Click"/>
                        <Button Content="Pencil" Tag="Pencil" Click="AddOperation_Click"/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Margin="4,0,8,0">
                    <TextBlock Text="OUTPUT" Foreground="#48B7A5" FontSize="11" FontWeight="Bold"/>
                    <Button Content="Postprocessa" Click="Post_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="3" Margin="0,0,5,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Browser progetto" FontWeight="SemiBold" Margin="12,12,8,8"/>
                    <TreeView Background="Transparent" BorderThickness="0" Foreground="#D7DCE5" Margin="5">
                        <TreeViewItem Header="Part_01" IsExpanded="True">
                            <TreeViewItem Header="Setup fresatura · XYZ" IsExpanded="True">
                                <TreeViewItem Header="Modello"/>
                                <TreeViewItem Header="Grezzo"/>
                                <TreeViewItem Header="Sistema coordinate"/>
                                <TreeViewItem Header="Utensili"/>
                                <TreeViewItem Header="Percorsi utensile" IsExpanded="True">
                                    <TreeViewItem Header="Nessun percorso calcolato"/>
                                </TreeViewItem>
                            </TreeViewItem>
                            <TreeViewItem Header="Setup tornitura · XZ"/>
                        </TreeViewItem>
                    </TreeView>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="#191C22" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="108"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Background="#20242B">
                        <TextBlock x:Name="WorkspaceTitle" Text="Fresatura 3 assi" FontWeight="SemiBold" Margin="12,0"/>
                        <TextBlock Text="Vista: Isometrica   ·   Unità: mm" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                    </DockPanel>
                    <Grid Grid.Row="1" ClipToBounds="True">
                        <Canvas>
                            <Ellipse Width="390" Height="82" Canvas.Left="190" Canvas.Top="390"
                                     Fill="#111317" Stroke="#323A44" StrokeThickness="2"/>
                            <Polygon Points="0,90 190,0 390,90 200,180" Canvas.Left="190" Canvas.Top="180"
                                     Fill="#596574" Stroke="#9AA6B5" StrokeThickness="2"/>
                            <Polygon Points="0,0 200,90 200,210 0,120" Canvas.Left="190" Canvas.Top="270"
                                     Fill="#424C59" Stroke="#9AA6B5" StrokeThickness="2"/>
                            <Polygon Points="200,90 390,0 390,120 200,210" Canvas.Left="390" Canvas.Top="270"
                                     Fill="#343D48" Stroke="#9AA6B5" StrokeThickness="2"/>
                            <TextBlock Canvas.Left="278" Canvas.Top="245" Text="Anteprima concettuale grezzo/pezzo"
                                       Foreground="#E7EAF0" FontSize="13"/>
                            <TextBlock Canvas.Left="24" Canvas.Top="24" Text="Viewport 3D · modello non caricato"
                                       Foreground="#A0A8B5" FontSize="12"/>
                            <TextBlock Canvas.Left="30" Canvas.Top="74" Text="X  →" Foreground="#E77D6B"/>
                            <TextBlock Canvas.Left="30" Canvas.Top="96" Text="Y  ↗" Foreground="#75C68C"/>
                            <TextBlock Canvas.Left="30" Canvas.Top="118" Text="Z  ↑" Foreground="#76A9E8"/>
                        </Canvas>
                    </Grid>
                    <Border Grid.Row="2" Background="#20242B" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                        <DockPanel Margin="10">
                            <TextBlock DockPanel.Dock="Top" Text="Operazioni pianificate" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ListBox x:Name="OperationList" Background="#191C22" Foreground="#E7EAF0"
                                     BorderBrush="#343A44" SelectionChanged="OperationList_SelectionChanged"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="13">
                        <TextBlock Text="Operazione selezionata" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
                        <TextBlock Text="Nome" Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="OperationName" Text="Nessuna operazione" Margin="0,4,0,10"
                                 Padding="7" Background="#191C22" Foreground="#E7EAF0" BorderBrush="#414956"/>
                        <TextBlock Text="Utensile" Foreground="{StaticResource MutedBrush}"/>
                        <ComboBox Margin="0,4,0,10" SelectedIndex="0">
                            <ComboBoxItem Content="T1 · Fresa piana Ø10 (esempio)"/>
                            <ComboBoxItem Content="T2 · Fresa sferica Ø6 (esempio)"/>
                            <ComboBoxItem Content="T3 · Punta Ø5 (esempio)"/>
                        </ComboBox>
                        <TextBlock Text="Postprocessore" Foreground="{StaticResource MutedBrush}"/>
                        <ComboBox Margin="0,4,0,10" SelectedIndex="0">
                            <ComboBoxItem Content="Centroid CNC · MILL (da validare)"/>
                            <ComboBoxItem Content="Siemens 808D TURN · futuro"/>
                        </ComboBox>
                        <TextBlock Text="Parametri previsti" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,5"/>
                        <CheckBox Content="Definizione grezzo e sovrametallo" IsChecked="True" Margin="0,3"/>
                        <CheckBox Content="Velocità, avanzamento e refrigerante" IsChecked="True" Margin="0,3"/>
                        <CheckBox Content="Altezza sicurezza e ritrazione" IsChecked="True" Margin="0,3"/>
                        <CheckBox Content="Passate e rilevamento materiale residuo" Margin="0,3"/>
                        <Separator Margin="0,12"/>
                        <TextBlock Text="Stato: solo bozza UI; nessun G-code viene generato."
                                   Foreground="#E9B96E" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="Calcola percorso utensile" IsEnabled="False"/>
                        <Button Content="Apri configurazione post" Click="Post_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Background="#111317">
            <TextBlock x:Name="StatusText" Text="Pronto · demo interfaccia, geometria e percorsi non calcolati"
                       Foreground="#A0A8B5" Margin="10,0"/>
            <TextBlock Text="ForgeCAM prototype" Foreground="#48B7A5" HorizontalAlignment="Right" Margin="0,0,10,0"/>
        </DockPanel>
    </Grid>
</Window>
